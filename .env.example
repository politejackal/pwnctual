# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: <PWNCTUAL_PUBLIC_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL of this site (used for sign-in callbacks)
PWNCTUAL_PUBLIC_URL=https://pwnctual.example.com
# Long random string; auto-generated into .secret if unset
PWNCTUAL_SECRET=
PWNCTUAL_SECURE_COOKIES=1
# Local development only: enables username login without GitHub
# PWNCTUAL_DEV=1
