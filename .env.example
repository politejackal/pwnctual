# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: <PWNCTUAL_PUBLIC_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google sign-in: https://console.cloud.google.com/auth/clients
#   Create client > Web application
#   Authorized redirect URI: <PWNCTUAL_PUBLIC_URL>/auth/google/callback
#   (for local testing also add http://127.0.0.1:5000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of this site (used for sign-in callbacks and the downloaded CLI)
PWNCTUAL_PUBLIC_URL=https://pwnctual.example.com
# Long random string; auto-generated into .secret if unset
PWNCTUAL_SECRET=
PWNCTUAL_SECURE_COOKIES=1
# Pro plan. Week 1 is always free; everything else needs Pro.
PWNCTUAL_PRO_PRICE=$10
# Payment link that sells Pro (e.g. a Stripe Payment Link). Leave empty to show
# "Checkout opens soon"; grant Pro by hand with: python -m pwnctual grant-pro LOGIN
PWNCTUAL_CHECKOUT_URL=
# Live classes (15-minute calls, bookable 08:00-24:00 in this timezone; learners
# see the slots in their own timezone). IANA name, e.g. Asia/Riyadh, Asia/Kolkata.
PWNCTUAL_CLASS_TZ=Asia/Riyadh
# Video link shown to people with a booking (e.g. your Google Meet room)
PWNCTUAL_CLASS_MEET_URL=
# Comma-separated logins who can see all bookings at /classes/admin
PWNCTUAL_ADMINS=
# Local development only: enables username login without GitHub
# PWNCTUAL_DEV=1
