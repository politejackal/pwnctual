{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pwnctual-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Level source files are bundled as plain text. Hidden tests are bundled
  // as JSON and only ever read inside the Worker.
  "rules": [
    { "type": "Text", "globs": ["**/*.c", "**/*.py"], "fallthrough": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pwnctual",
      // Replace with the id that `wrangler d1 create pwnctual` prints
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Your Judge0 server, e.g. https://judge0.example.com
    "JUDGE0_URL": "",
    // Judge0 CE 1.13.x ids: 50 = C (GCC 9.2.0), 71 = Python (3.8.1)
    "JUDGE0_LANGUAGE_C": "50",
    "JUDGE0_LANGUAGE_PYTHON": "71",
    // Comma-separated origins allowed to call the API from a browser.
    // Same-origin requests (site and API both on pwnctual.com) don't need this.
    "ALLOWED_ORIGINS": "https://pwnctual.com"
  },
  // JUDGE0_TOKEN is a secret: `wrangler secret put JUDGE0_TOKEN`
  "routes": [
    { "pattern": "pwnctual.com/api/*", "zone_name": "pwnctual.com" }
  ]
}
