{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pwnctual-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Level sources are bundled as plain text. Hidden tests are not bundled:
  // they live on the runner VM.
  "rules": [
    { "type": "Text", "globs": ["**/*.c", "**/*.py"], "fallthrough": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pwnctual",
      "database_id": "be1859c6-05a0-4542-a421-dfa74b57c191",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The runner on the VM, e.g. https://runner.pwnctual.com
    "RUNNER_URL": "",
    // Comma-separated origins allowed to call the API from a browser.
    // Same-origin requests (site and API both on pwnctual.com) don't need this.
    "ALLOWED_ORIGINS": "https://pwnctual.pages.dev,https://pwnctual.com"
  },
  // RUNNER_KEY is a secret: `wrangler secret put RUNNER_KEY --config api/wrangler.jsonc`
  // Reachable at pwnctual-api.<your subdomain>.workers.dev until pwnctual.com moves to
  // Pages. Then add: "routes": [{ "pattern": "pwnctual.com/api/*", "zone_name": "pwnctual.com" }]
  "workers_dev": true
}
