{
  "name": "pwnctual",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "PWNCTUAL_URL": "https://pwnctual.example.com"
  },
  "postCreateCommand": "sudo install -m 0755 bin/pwnctual /usr/local/bin/pwnctual && mkdir -p solutions",
  "postAttachCommand": "echo '\\n  💀 pwnctual workspace ready. Run: pwnctual login\\n'",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "workbench.colorTheme": "Default Dark Modern",
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "hostRequirements": { "cpus": 2 }
}
